# =============================================================================
# The Nazar EXTENSION needs NO environment variables. It runs as-is.
#
# This file documents the env vars for the OPTIONAL AI backend — a separate
# service you host (Next.js API route, etc.) that the extension calls for
# LLM-based policy grading. Copy these into THAT backend project's own env
# (e.g. .env.local and your host's dashboard), not into the extension.
#
# Without a backend, Nazar falls back to local keyword heuristics and still
# blocks cookies, trackers, and sends GPC. The backend only adds smarter
# policy grading.
# =============================================================================

# Anthropic API key — used server-side ONLY, never shipped in the extension.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# MongoDB connection for the shared grade cache (a site graded once is free
# for everyone after). Use a database dedicated to Nazar.
NAZAR_MONGODB_URI=mongodb+srv://user:password@your-cluster.mongodb.net/nazar?retryWrites=true&w=majority
NAZAR_MONGODB_DB=nazar

# Optional spend guards (defaults shown).
NAZAR_MAX_DAILY_CALLS=200   # global model calls per day, then everyone falls back to heuristics
NAZAR_IP_DAILY_CAP=40       # per-IP model calls per day, stops one abuser draining the budget
